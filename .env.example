# --- AI (server-side only; never prefix with NEXT_PUBLIC_) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1     # any OpenAI-compatible endpoint

# --- Database (optional: falls back to local .data/ JSON files for dev) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---
SESSION_SECRET=change-me-to-a-long-random-string      # openssl rand -base64 48
ENCRYPTION_KEY=change-me-another-long-random-string   # field-level encryption of appointment contacts

# --- Admin dashboard (role-based) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=          # role: admin   (aggregate stats + appointment requests + providers)
ANALYST_EMAIL=
ANALYST_PASSWORD=        # role: analyst (aggregate stats only, no personal data)
